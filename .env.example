# Copy required values into Render > Environment. Never commit populated secrets.
PORT=3000
ASSISTANT_WEBHOOK_TOKEN=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-a-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional outbound PHONE call via Infobip Calls API and OpenAI Realtime SIP.
# Calls remain off until explicitly enabled.
ENABLE_OUTBOUND_CALLS=false
INFOBIP_BASE_URL=https://YOUR-SUBDOMAIN.api.infobip.com
INFOBIP_API_KEY=replace-with-an-infobip-calls-api-key
INFOBIP_VOICE_FROM=5511888888888
INFOBIP_CALLS_CONFIGURATION_ID=replace-with-your-calls-configuration-id
INFOBIP_SIP_TRUNK_ID=replace-with-your-sip-trunk-id
INFOBIP_EVENTS_USERNAME=replace-with-your-subscription-basic-username
INFOBIP_EVENTS_TOKEN=replace-with-your-subscription-basic-password
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_PROJECT_ID=replace-with-the-realtime-sip-project-id
OPENAI_WEBHOOK_SECRET=replace-with-the-openai-webhook-signing-secret
OPENAI_REALTIME_MODEL=replace-with-a-current-supported-realtime-model
DEMO_ALLOWED_PHONE=5511999999999
